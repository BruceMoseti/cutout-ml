# CutoutML configuration.
#
# Copy to `.env` and edit. Every value below is read by `cutoutml.core.config.Settings`
# with the CUTOUTML_ prefix, and every field of that class appears here — if you add a
# setting, add it here too, because this file is the documentation for it.
#
# The values shown are the in-code defaults except where marked. NO REAL SECRET BELONGS
# IN THIS FILE; `.env` is gitignored, `.env.example` is not.
#
# Commented-out lines are settings whose default is correct for local development and
# which you only need to touch in a real deployment.

# ------------------------------------------------------------------------ general
# dev | test | prod. `prod` is what makes the API refuse to boot with a default
# JWT secret (see docs/security.md).
CUTOUTML_ENVIRONMENT=dev
CUTOUTML_LOG_LEVEL=INFO
# json for anything that ships logs; console for a readable local terminal.
CUTOUTML_LOG_FORMAT=console

# ------------------------------------------------------------------------ storage
# local | s3. `local` writes under CUTOUTML_STORAGE_ROOT; `s3` talks to any
# S3-compatible endpoint, which is how the compose stack uses MinIO.
CUTOUTML_STORAGE_BACKEND=local
CUTOUTML_STORAGE_ROOT=./storage
# CUTOUTML_S3_BUCKET=cutoutml
# Set for MinIO or any non-AWS endpoint; leave unset for real S3.
# CUTOUTML_S3_ENDPOINT_URL=http://minio:9000
# CUTOUTML_S3_REGION=us-east-1
# Credentials: leave unset to use the ambient AWS credential chain (instance role,
# IRSA, ~/.aws/credentials), which is the right answer in production.
# CUTOUTML_S3_ACCESS_KEY_ID=
# CUTOUTML_S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing; real S3 does not care.
# CUTOUTML_S3_FORCE_PATH_STYLE=true
# How long a presigned upload/download URL stays valid, in seconds.
# CUTOUTML_PRESIGN_EXPIRY_SECONDS=900

# ----------------------------------------------------------------------- database
CUTOUTML_DATABASE_URL=postgresql+psycopg://dev:dev@127.0.0.1:5432/cutoutml
# CUTOUTML_DB_POOL_SIZE=5
# CUTOUTML_DB_MAX_OVERFLOW=10
# Echo every statement. Useful once, painful thereafter.
# CUTOUTML_DB_ECHO=false

# -------------------------------------------------------------------------- queue
CUTOUTML_REDIS_URL=redis://127.0.0.1:6379/0
# Broker and result backend both default to CUTOUTML_REDIS_URL. Split them when the
# result backend should not share a failure domain with the broker.
# CUTOUTML_CELERY_BROKER_URL=
# CUTOUTML_CELERY_RESULT_BACKEND=
# Run tasks inline in the calling process. Tests only — it hides every serialisation
# and broker bug you actually want to find.
# CUTOUTML_CELERY_TASK_ALWAYS_EAGER=false

# --------------------------------------------------------------------------- auth
# REQUIRED in production. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CUTOUTML_JWT_SECRET=change-me-in-production
# CUTOUTML_JWT_ALGORITHM=HS256
# CUTOUTML_JWT_ACCESS_TTL_SECONDS=3600
# CUTOUTML_JWT_ISSUER=cutoutml

# ------------------------------------------------------------------------- limits
# 32 MiB. Enforced twice: by middleware on Content-Length and by a streaming byte
# counter, because Content-Length is a claim, not a fact.
# CUTOUTML_MAX_UPLOAD_BYTES=33554432
# 256 MiB.
# CUTOUTML_MAX_VIDEO_UPLOAD_BYTES=268435456
# CUTOUTML_RATE_LIMIT_PER_MINUTE=120
# CUTOUTML_RATE_LIMIT_BURST=30
# Decompression-bomb guard: refuse images whose declared dimensions exceed this
# product before allocating pixels for them.
# CUTOUTML_MAX_IMAGE_PIXELS=64000000

# ------------------------------------------------------------------------- models
CUTOUTML_DEFAULT_MODEL=cutoutnet
CUTOUTML_MODEL_WEIGHTS_DIR=./models
# auto | cpu | cuda | cuda:N | mps. `auto` prefers CUDA, then MPS, then CPU.
CUTOUTML_DEVICE=auto
# fp32 | fp16 | bf16. A request that the device cannot honour is downgraded with a
# warning rather than refused: fp16 off CUDA becomes bf16 (or fp32), bf16 without
# hardware support becomes fp32.
CUTOUTML_PRECISION=fp32
# 0 leaves PyTorch's thread heuristic alone. Pin it to the container's CPU limit when
# running more than one worker per host, or the workers will fight over cores.
# CUTOUTML_TORCH_NUM_THREADS=0

# -------------------------------------------------------------------------- video
# CUTOUTML_FFMPEG_BINARY=ffmpeg
# CUTOUTML_FFPROBE_BINARY=ffprobe
# CUTOUTML_VIDEO_FRAME_QUEUE_SIZE=8
# Frames per forward pass. Peak RAM is roughly batch x width x height x 3.
# CUTOUTML_VIDEO_BATCH_SIZE=4
# Hard ceiling on frames per job: 18000 is 10 minutes at 30 fps.
# CUTOUTML_MAX_VIDEO_FRAMES=18000

# --------------------------------------------------------------------------- misc
# CUTOUTML_BENCHMARK_RESULTS_DIR=./benchmarks/results
# CUTOUTML_DATASET_CACHE_DIR=./artifacts/datasets
# Inbound request-id header, echoed on every response and attached to every log line.
# CUTOUTML_REQUEST_ID_HEADER=X-Request-ID

# ---------------------------------------------------------------------- frontend
# Where the Next.js dev server proxies /api to. Leave unset and the browser talks to
# the frontend's own origin, which sidesteps CORS entirely.
CUTOUTML_API_URL=http://127.0.0.1:8000
# Set this only to bypass the proxy and call the API cross-origin. The API's CORS
# allow-list must then include the frontend's origin.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --------------------------------------------------- docker compose only (not app)
# Consumed by docker-compose.yml to provision the Postgres and MinIO containers.
# These are local development credentials for throwaway containers.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=cutoutml
MINIO_ROOT_USER=cutoutml
MINIO_ROOT_PASSWORD=cutoutml-dev-secret
