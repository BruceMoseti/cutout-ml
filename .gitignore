# Local data. Anchored to the repo root so that the `src/cutoutml/storage`
# package is not swallowed by the runtime storage-root pattern.
/data/
/storage/
/uploads/
/tmp/
*.db
*.sqlite3

# Model weights, exported graphs and engines. Nothing binary is committed: see
# docs/models.md for how to obtain or reproduce every checkpoint the benchmark
# suite uses. `make train` regenerates the in-repo ones from a seeded dataset.
*.pth
*.pt
*.onnx
*.engine
*.plan

# Generated previews, dataset caches and rendered training/eval artefacts.
/artifacts/
/training/runs/*.png

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test artifacts
playwright-report/
test-results/
